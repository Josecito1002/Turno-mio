# Postgres. Con Supabase usa el pooler en MODO SESIÓN (puerto 5432):
#   postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
# (el host directo db.<ref>.supabase.co es solo IPv6, y el modo transacción 6543 se cuelga con consultas en paralelo)
# Para desarrollo sin servidor: pglite:./.data/pg
DATABASE_URL=pglite:./.data/pg
# Genera uno con: npx auth secret
AUTH_SECRET=
# Correos separados por coma que quedan como administradores al registrarse
ADMIN_EMAILS=
